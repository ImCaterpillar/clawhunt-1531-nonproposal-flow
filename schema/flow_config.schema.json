{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "公司级非提案业务试点流程配置",
  "type": "object",
  "required": [
    "flow_id", "flow_name", "task_type", "steps",
    "knowledge_mounts", "approval_gates", "evaluation"
  ],
  "additionalProperties": false,
  "properties": {
    "flow_id": { "type": "string", "pattern": "^flow-[a-z][a-z0-9-]{2,47}$" },
    "flow_name": { "type": "string", "minLength": 2, "maxLength": 80 },
    "task_type": { "type": "string", "minLength": 2 },
    "description": { "type": "string", "minLength": 5, "maxLength": 300 },
    "steps": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["step_id", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "step_id": { "type": "string", "pattern": "^s[0-9]+$" },
          "name": { "type": "string", "minLength": 2 },
          "kind": {
            "type": "string",
            "enum": ["collect_input", "knowledge_check", "orchestrate",
                     "approval", "evaluate", "archive"]
          }
        }
      }
    },
    "knowledge_mounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["knowledge_id", "purpose"],
        "additionalProperties": false,
        "properties": {
          "knowledge_id": { "type": "string", "minLength": 2 },
          "purpose": { "type": "string", "minLength": 3 }
        }
      }
    },
    "approval_gates": {
      "type": "object",
      "required": ["required", "approver_role", "policy"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "approver_role": { "type": "string", "minLength": 2 },
        "policy": { "type": "string", "minLength": 5 }
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["criteria", "target"],
      "additionalProperties": false,
      "properties": {
        "criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "target": { "type": "string", "minLength": 3 }
      }
    }
  }
}